# --- Backend ---------------------------------------------------------------
# Defaults to SQLite at backend/honeychain.db when unset (docker-compose sets Postgres).
# DATABASE_URL=postgresql://honeyuser:honeypassword@localhost:5432/honeydb
# Comma-separated origins allowed to call the API ("*" for any).
CORS_ORIGINS=*
# Base URL printed into batch QR codes (the consumer passport lives at /consumer/<batch id>).
# Defaults to http://<this machine's LAN IP>:3000 so phones on the same Wi-Fi can scan them;
# set it to your public URL when deployed. Never use localhost here — phones can't reach it.
# FRONTEND_URL=https://honeychain.example.org
# Seed the demo dataset automatically when the database is empty.
AUTO_SEED=true

# --- Blockchain ------------------------------------------------------------
# "demo" anchors batches with local SHA-256 hashes; "sepolia" mints real ERC-721 tokens.
BLOCKCHAIN_MODE=demo
IPFS_MODE=demo
# Required only for BLOCKCHAIN_MODE=sepolia (see blockchain/scripts/deploy.js).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=your_private_key_here
CONTRACT_ADDRESS=0xYourContractAddressHere

# IPFS Configuration (Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# --- Frontend (frontend/.env.local) ------------------------------------------
# Defaults to port 8010 on whatever host served the page (works from phones on the LAN).
# NEXT_PUBLIC_API_URL=http://localhost:8010
